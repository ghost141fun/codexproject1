
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user within the DevTalk application, storing their profile information.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity."
        },
        "displayName": {
          "type": "string",
          "description": "The name displayed for the user in the application."
        },
        "email": {
          "type": "string",
          "description": "The user's email address, used for contact and potentially login.",
          "format": "email"
        },
        "avatarUrl": {
          "type": "string",
          "description": "URL to the user's profile avatar image.",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "displayName",
        "email"
      ]
    },
    "Workspace": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Workspace",
      "type": "object",
      "description": "Represents a collaborative environment.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "memberIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "ownerId", "memberIds", "createdAt"]
    },
    "Channel": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Channel",
      "type": "object",
      "description": "A communication channel.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "isPrivate": { "type": "boolean" },
        "workspaceId": { "type": "string" },
        "creatorId": { "type": "string" },
        "memberIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "isPrivate", "workspaceId", "creatorId", "memberIds", "createdAt"]
    },
    "Huddle": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Huddle",
      "type": "object",
      "description": "An active huddle session.",
      "properties": {
        "id": { "type": "string" },
        "participantIds": { "type": "array", "items": { "type": "string" } },
        "startedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "participantIds"]
    },
    "Message": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "senderId", "content", "timestamp"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/userProfiles/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "User profiles."
    },
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/backend/entities/Workspace" },
      "description": "Workspaces."
    },
    "/workspaces/{workspaceId}/channels/{channelId}": {
      "schema": { "$ref": "#/backend/entities/Channel" },
      "description": "Workspace channels."
    },
    "/workspaces/{workspaceId}/channels/{channelId}/huddle/active": {
      "schema": { "$ref": "#/backend/entities/Huddle" },
      "description": "Real-time huddle presence."
    },
    "/workspaces/{workspaceId}/channels/{channelId}/messages/{messageId}": {
      "schema": { "$ref": "#/backend/entities/Message" },
      "description": "Channel messages."
    }
  }
}
